{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static site only: Cloudflare serves the prerendered build/ folder, no Worker code.
	// Without this file `wrangler deploy` tries to convert the project to adapter-cloudflare.
	"name": "chemtable",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./build",
		// /iron → iron.html, /ru → ru.html
		"html_handling": "auto-trailing-slash",
		// Missing addresses get the nearest 404.html with status 404: /ru/typo → /ru/404.html
		"not_found_handling": "404-page"
	}
}
